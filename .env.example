# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Your deployed app URL — used for auth redirects in SSR/production
# In development this is not needed (browser origin is used automatically)
VITE_APP_URL=https://yourdomain.com

# n8n automation webhook (optional — skipped if not set)
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/xxx

# Decentro payment API (required for purchases)
VITE_DECENTRO_API_KEY=your-decentro-client-id
VITE_DECENTRO_BASE_URL=https://in.decentro.tech

# Polygon smart contract (Amoy testnet)
VITE_CONTRACT_ADDRESS=0xd9145CCE52D386f254917e481eB44e9943F39138
