# ── Supabase (required) ───────────────────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Polygon Smart Contract (required) ─────────────────────────────────────────
VITE_CONTRACT_ADDRESS=your_contract_address

# ── n8n Automation Webhook (add when ready) ───────────────────────────────────
# Fires after farmer registration → triggers NDVI pipeline
VITE_N8N_WEBHOOK_URL=your_n8n_webhook_url_add_when_ready

# ── Decentro Payment Gateway (add when ready) ─────────────────────────────────
VITE_DECENTRO_API_KEY=your_decentro_key_add_when_ready
VITE_DECENTRO_BASE_URL=https://in.decentro.tech

# ── App URL (production only) ─────────────────────────────────────────────────
# Used for auth redirects in SSR/production. Not needed in development.
VITE_APP_URL=https://yourdomain.com
